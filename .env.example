# VitalGuard AI - Environment Configuration Example
# Copy this file to .env for custom local settings

FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Hospital EHR Integration Settings (Demo Mock)
EHR_HOSPITAL_NAME=VitalCare Hospital – Demo EHR
EHR_API_TOKEN=vitalguard-ehr-secure-demo-key-2026
EHR_ENDPOINT_URL=http://127.0.0.1:5000/api/ehr
EHR_GATEWAY_TIMEOUT_SEC=5
